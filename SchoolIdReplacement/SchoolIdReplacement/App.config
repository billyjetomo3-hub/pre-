<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
  </startup>
  <connectionStrings>
    <!--
      Portable Multi-PC Database Configuration:
      1. If "Auto" (default), the app automatically detects and connects to:
         - (LocalDB)\MSSQLLocalDB
         - (LocalDB)\v11.0
         - .\SQLEXPRESS
         - localhost
         And if no SQL Server instance is installed on the PC/laptop at all,
         it automatically switches to a zero-install local file database
         saved in %LOCALAPPDATA%\SchoolIdReplacement\SchoolIdReplacementDb.xml
         so the app works immediately on ANY Windows PC or laptop!
      2. To force a specific SQL Server instance, replace "Auto" with your connection string, e.g.:
         Data Source=.\SQLEXPRESS;Initial Catalog=SchoolIdReplacementDb;Integrated Security=True
    -->
    <add name="SchoolIdDb"
         connectionString="Auto"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
